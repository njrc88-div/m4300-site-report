# Local username/password login for this app - entirely optional. Copy
# this file to `.env` and fill in real values to enable it; leave `.env`
# missing (or SESSION_SECRET_KEY unset) and the app runs exactly as
# before, with no login gate at all. See README.md's "Login" section for
# more detail.

# Any long random string - used to sign the session cookie. Generate one
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=

# Used only once, on first startup, if no accounts exist yet - creates
# this account as the first admin so there's someone who can sign in and
# create everyone else via the Admin page. Safe to leave set afterwards;
# it's ignored once at least one account exists.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# Set to "true" once this runs behind real https - the session cookie is
# marked Secure then, which browsers silently drop over plain http.
SESSION_COOKIE_SECURE=false
