# Google sign-in for this app - entirely optional. Copy this file to
# `.env` and fill in real values to enable it; leave `.env` missing (or
# these three unset) and the app runs exactly as before, with no login
# gate at all. See README.md's "Google sign-in" section for how to create
# the OAuth client in Google Cloud Console.

# From your Google Cloud OAuth 2.0 Client ID (Web application type).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string - used to sign the session cookie. Generate one
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=

# Comma-separated list of Google account emails allowed to sign in, e.g.
# ALLOWED_GOOGLE_EMAILS=you@gmail.com,teammate@gmail.com
# Leave empty to allow any Google account that completes sign-in (only
# reasonable if your OAuth consent screen is in Testing mode with its own
# Google-side test-user allow-list - otherwise anyone with a Google
# account could sign in).
ALLOWED_GOOGLE_EMAILS=

# Set to "true" once this runs behind real https - the session cookie is
# marked Secure then, which browsers silently drop over plain http.
SESSION_COOKIE_SECURE=false
